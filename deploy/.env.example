# Não grave senhas reais neste arquivo. Cadastre-as apenas no painel do Render.
SPRING_PROFILES_ACTIVE=cloud
# Copie o host do Session pooler do seu projeto (porta 5432, IPv4).
# Baixe o certificado do Supabase e adicione no Render como secret file: supabase-ca.crt
DB_URL=jdbc:postgresql://SEU-HOST.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
DB_USERNAME=postgres.REFERENCIA-DO-PROJETO
DB_PASSWORD=PREENCHER-NO-RENDER
APP_LOGIN_USERNAME=PREENCHER-NO-RENDER
APP_LOGIN_PASSWORD_HASH=PREENCHER-NO-RENDER
